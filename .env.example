# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase shared pooler, transaction mode (copy the full host from Dashboard > Connect)
# The app disables prepared statements, so transaction mode is appropriate here.
DATABASE_URL=postgres://postgres.your-project:password@your-pooler-host.supabase.com:6543/postgres

# Only needed by scripts/import-records.mjs. Set the UUID directly, or leave
# blank and set the three alternatives below to resolve the user by email.
# Never expose the service role key in a NEXT_PUBLIC_* variable.
SUPABASE_USER_ID=
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_USER_EMAIL=you@example.com

# Only needed by the API test scripts
SUPABASE_USER_PASSWORD=your-password
